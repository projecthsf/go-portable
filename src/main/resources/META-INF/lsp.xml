<idea-plugin>
    <!-- Optional Go code-intelligence layer. Loaded only when the LSP4IJ plugin is present
         (declared via <depends optional config-file="lsp.xml"> in plugin.xml). Registers a
         gopls-backed language server with LSP4IJ and maps it to our GoPortable file type,
         so it activates only where our file type owns .go (IDEA Community, not GoLand). -->
    <extensions defaultExtensionNs="com.redhat.devtools.lsp4ij">
        <server
            id="goPortable"
            name="Go (Portable)"
            factoryClass="io.genai.go.lsp.GoLanguageServerFactory">
            <description><![CDATA[
                Go completion, navigation and diagnostics via gopls, running on the portable
                Go toolchain. Fully local and offline.
            ]]></description>
        </server>
        <!-- languageId MUST be "go": gopls ignores files whose LSP languageId isn't "go".
             Our IntelliJ language id is "GoPortable" (unique, to coexist with the official Go
             plugin), so without this override LSP4IJ would send languageId="goportable" and
             gopls would reject every file. -->
        <languageMapping language="GoPortable" serverId="goPortable" languageId="go"/>
    </extensions>
</idea-plugin>
